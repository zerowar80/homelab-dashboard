PORT=3000

# --- Proxmox VE ---
# Datacenter > Permissions > API Tokens 에서 발급 (Privilege Separation 체크 해제 권장)
PROXMOX_HOST=https://192.168.1.10:8006
PROXMOX_TOKEN_ID=root@pam!dashboard
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000

# --- Synology DSM ---
# 제어판 > 사용자 계정에서 읽기 전용 계정을 새로 만들어 쓰는 걸 권장합니다.
SYNOLOGY_HOST=https://192.168.1.20:5001
SYNOLOGY_USER=dashboard-readonly
SYNOLOGY_PASSWORD=your-password-here
